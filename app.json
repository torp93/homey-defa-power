{
  "id": "com.thomastorp.defa-power",
  "version": "1.1.6",
  "compatibility": ">=12.4.5",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "en": "DEFA Power",
    "no": "DEFA Power"
  },
  "description": {
    "en": "Your DEFA charger, on your terms.",
    "no": "DEFA-laderen din, på dine premisser."
  },
  "category": [
    "energy"
  ],
  "brandColor": "#E11F1D",
  "permissions": [],
  "api": {
    "getSession": {
      "method": "GET",
      "path": "/session"
    },
    "testConnection": {
      "method": "GET",
      "path": "/test"
    },
    "sendCode": {
      "method": "POST",
      "path": "/login/sms"
    },
    "login": {
      "method": "POST",
      "path": "/login"
    },
    "logout": {
      "method": "POST",
      "path": "/logout"
    }
  },
  "capabilities": {
    "defa_status": {
      "type": "enum",
      "title": {
        "en": "Charger status",
        "no": "Laderstatus"
      },
      "getable": true,
      "setable": false,
      "uiComponent": null,
      "icon": "/assets/capability-icons/status.svg",
      "values": [
        {
          "id": "available",
          "title": {
            "en": "Available",
            "no": "Ledig"
          }
        },
        {
          "id": "occupied",
          "title": {
            "en": "Occupied",
            "no": "Opptatt"
          }
        },
        {
          "id": "preparing",
          "title": {
            "en": "Preparing",
            "no": "Forbereder"
          }
        },
        {
          "id": "charging",
          "title": {
            "en": "Charging",
            "no": "Lader"
          }
        },
        {
          "id": "suspended_ev",
          "title": {
            "en": "Paused by the car",
            "no": "Pauset av bilen"
          }
        },
        {
          "id": "suspended_evse",
          "title": {
            "en": "Paused by the charger",
            "no": "Pauset av laderen"
          }
        },
        {
          "id": "finishing",
          "title": {
            "en": "Finishing",
            "no": "Avslutter"
          }
        },
        {
          "id": "faulted",
          "title": {
            "en": "Fault",
            "no": "Feil"
          }
        },
        {
          "id": "unavailable",
          "title": {
            "en": "Unavailable",
            "no": "Utilgjengelig"
          }
        },
        {
          "id": "reserved",
          "title": {
            "en": "Reserved",
            "no": "Reservert"
          }
        },
        {
          "id": "restarting",
          "title": {
            "en": "Restarting",
            "no": "Starter på nytt"
          }
        },
        {
          "id": "facility_finishing",
          "title": {
            "en": "Facility finishing",
            "no": "Anlegget avslutter"
          }
        },
        {
          "id": "idle",
          "title": {
            "en": "Idle",
            "no": "Inaktiv"
          }
        },
        {
          "id": "ev_connected",
          "title": {
            "en": "Car connected",
            "no": "Bil tilkoblet"
          }
        },
        {
          "id": "unknown",
          "title": {
            "en": "Unknown",
            "no": "Ukjent"
          }
        }
      ]
    },
    "defa_charging_state": {
      "type": "enum",
      "title": {
        "en": "Charging state",
        "no": "Ladetilstand"
      },
      "getable": true,
      "setable": false,
      "uiComponent": null,
      "icon": "/assets/capability-icons/charging.svg",
      "values": [
        {
          "id": "idle",
          "title": {
            "en": "Idle",
            "no": "Inaktiv"
          }
        },
        {
          "id": "ev_connected",
          "title": {
            "en": "Car connected",
            "no": "Bil tilkoblet"
          }
        },
        {
          "id": "charging",
          "title": {
            "en": "Charging",
            "no": "Lader"
          }
        },
        {
          "id": "suspended_ev",
          "title": {
            "en": "Paused by the car",
            "no": "Pauset av bilen"
          }
        },
        {
          "id": "suspended_evse",
          "title": {
            "en": "Paused by the charger",
            "no": "Pauset av laderen"
          }
        },
        {
          "id": "unrecognized",
          "title": {
            "en": "Unrecognized",
            "no": "Ukjent tilstand"
          }
        }
      ]
    },
    "defa_session_energy": {
      "type": "number",
      "title": {
        "en": "This session",
        "no": "Denne økten"
      },
      "getable": true,
      "setable": false,
      "insights": true,
      "uiComponent": "sensor",
      "icon": "/assets/capability-icons/session.svg",
      "units": {
        "en": "kWh",
        "no": "kWh"
      },
      "min": 0,
      "decimals": 2
    },
    "defa_error_code": {
      "type": "string",
      "title": {
        "en": "Error code",
        "no": "Feilkode"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/capability-icons/error.svg"
    },
    "defa_last_update": {
      "type": "string",
      "title": {
        "en": "Last update",
        "no": "Siste oppdatering"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/capability-icons/clock-check.svg"
    },
    "defa_eco_mode": {
      "type": "boolean",
      "title": {
        "en": "Eco mode",
        "no": "Eco-modus"
      },
      "getable": true,
      "setable": true,
      "uiComponent": "toggle",
      "icon": "/assets/capability-icons/eco.svg"
    },
    "defa_button_override": {
      "type": "boolean",
      "title": {
        "en": "Charge now",
        "no": "Lad nå"
      },
      "getable": false,
      "setable": true,
      "uiComponent": "button",
      "icon": "/assets/capability-icons/override.svg"
    },
    "defa_button_reset": {
      "type": "boolean",
      "title": {
        "en": "Restart charger",
        "no": "Restart laderen"
      },
      "getable": false,
      "setable": true,
      "uiComponent": "button",
      "icon": "/assets/capability-icons/restart.svg"
    },
    "defa_button_refresh": {
      "type": "boolean",
      "title": {
        "en": "Refresh now",
        "no": "Oppdater nå"
      },
      "getable": false,
      "setable": true,
      "uiComponent": "button",
      "icon": "/assets/capability-icons/refresh.svg"
    },
    "defa_charge_current": {
      "type": "number",
      "title": {
        "en": "Charging current",
        "no": "Ladestrøm"
      },
      "getable": true,
      "setable": true,
      "insights": true,
      "chartType": "stepLine",
      "uiComponent": "slider",
      "icon": "/assets/capability-icons/current.svg",
      "units": {
        "en": "A",
        "no": "A"
      },
      "min": 7,
      "max": 32,
      "step": 1,
      "decimals": 0
    },
    "defa_plug_and_charge": {
      "type": "boolean",
      "title": {
        "en": "Plug & Charge",
        "no": "Plug & Charge"
      },
      "getable": true,
      "setable": true,
      "insights": true,
      "insightsTitleTrue": {
        "en": "Plug & Charge enabled",
        "no": "Plug & Charge slått på"
      },
      "insightsTitleFalse": {
        "en": "Plug & Charge disabled",
        "no": "Plug & Charge slått av"
      },
      "uiComponent": "toggle",
      "icon": "/assets/capability-icons/plug.svg"
    },
    "defa_charge_offline": {
      "type": "boolean",
      "title": {
        "en": "Charge offline",
        "no": "Lad offline"
      },
      "getable": true,
      "setable": true,
      "uiComponent": "toggle",
      "icon": "/assets/capability-icons/offline.svg"
    }
  },
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Thomas Torp"
  },
  "source": "https://github.com/torp93/homey-defa-power",
  "support": "https://github.com/torp93/homey-defa-power/issues",
  "bugs": {
    "url": "https://github.com/torp93/homey-defa-power/issues"
  },
  "contributing": {
    "donate": {
      "paypal": {
        "username": "torpthomas"
      },
      "githubSponsors": {
        "username": "torp93"
      }
    }
  },
  "flow": {
    "triggers": [
      {
        "id": "defa_charging_started",
        "title": {
          "en": "Charging starts",
          "no": "Ladingen starter"
        },
        "deprecated": true,
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=charger"
          }
        ]
      },
      {
        "id": "defa_charging_stopped",
        "title": {
          "en": "A charging session ends",
          "no": "En ladeøkt avsluttes"
        },
        "hint": {
          "en": "Also gives you the energy used during the session that just ended.",
          "no": "Gir deg også energien som gikk med i økten som nettopp ble avsluttet."
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=charger"
          }
        ],
        "tokens": [
          {
            "name": "session_energy",
            "type": "number",
            "title": {
              "en": "Session energy",
              "no": "Energi denne økten"
            },
            "example": 12.4
          }
        ]
      },
      {
        "id": "defa_car_connected",
        "title": {
          "en": "A car is plugged in",
          "no": "En bil kobles til"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=charger"
          }
        ]
      },
      {
        "id": "defa_car_disconnected",
        "title": {
          "en": "The car is unplugged",
          "no": "Bilen kobles fra"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=charger"
          }
        ]
      },
      {
        "id": "defa_status_changed",
        "title": {
          "en": "The charger status changes",
          "no": "Laderstatusen endres"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=charger"
          }
        ],
        "tokens": [
          {
            "name": "status",
            "type": "string",
            "title": {
              "en": "Status",
              "no": "Status"
            },
            "example": "charging"
          }
        ]
      },
      {
        "id": "defa_error_occurred",
        "title": {
          "en": "The charger reports an error",
          "no": "Laderen melder en feil"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=charger"
          }
        ],
        "tokens": [
          {
            "name": "error_code",
            "type": "string",
            "title": {
              "en": "Error code",
              "no": "Feilkode"
            },
            "example": "GroundFailure"
          }
        ]
      },
      {
        "id": "defa_error_cleared",
        "title": {
          "en": "The error is cleared",
          "no": "Feilen er borte"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=charger"
          }
        ]
      },
      {
        "id": "defa_eco_mode_changed",
        "title": {
          "en": "Eco mode is turned on or off",
          "no": "Eco-modus slås på eller av"
        },
        "hint": {
          "en": "Also fires when eco mode is changed from the DEFA app or the charger itself.",
          "no": "Fyrer også når eco-modus endres fra DEFA-appen eller laderen selv."
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=charger"
          }
        ],
        "tokens": [
          {
            "name": "enabled",
            "type": "boolean",
            "title": {
              "en": "Turned on",
              "no": "Slått på"
            },
            "example": true
          }
        ]
      },
      {
        "id": "defa_plug_and_charge_changed",
        "title": {
          "en": "Plug & Charge is turned on or off",
          "no": "Plug & Charge slås på eller av"
        },
        "hint": {
          "en": "Also fires when the setting is changed outside Homey. With Plug & Charge on, anyone who plugs in can charge without authorisation.",
          "no": "Fyrer også når innstillingen endres utenfor Homey. Med Plug & Charge på kan hvem som helst som plugger seg inn lade uten autorisasjon."
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=charger"
          }
        ],
        "tokens": [
          {
            "name": "enabled",
            "type": "boolean",
            "title": {
              "en": "Turned on",
              "no": "Slått på"
            },
            "example": true
          }
        ]
      },
      {
        "id": "defa_charge_offline_changed",
        "title": {
          "en": "Offline charging is turned on or off",
          "no": "Offline-lading slås på eller av"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=charger"
          }
        ],
        "tokens": [
          {
            "name": "enabled",
            "type": "boolean",
            "title": {
              "en": "Turned on",
              "no": "Slått på"
            },
            "example": true
          }
        ]
      }
    ],
    "conditions": [
      {
        "id": "defa_condition_charging",
        "title": {
          "en": "The charger !{{is|isn't}} charging",
          "no": "Laderen !{{lader|lader ikke}}"
        },
        "deprecated": true,
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=charger"
          }
        ]
      },
      {
        "id": "defa_condition_car_connected",
        "title": {
          "en": "A car !{{is|isn't}} plugged in",
          "no": "En bil !{{er|er ikke}} tilkoblet"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=charger"
          }
        ]
      },
      {
        "id": "defa_condition_eco_mode",
        "title": {
          "en": "Eco mode !{{is|isn't}} active",
          "no": "Eco-modus !{{er|er ikke}} aktiv"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=charger"
          }
        ]
      },
      {
        "id": "defa_condition_plug_and_charge",
        "title": {
          "en": "Plug & Charge !{{is|isn't}} enabled",
          "no": "Plug & Charge !{{er|er ikke}} slått på"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=charger"
          }
        ]
      },
      {
        "id": "defa_condition_charge_offline",
        "title": {
          "en": "Offline charging !{{is|isn't}} enabled",
          "no": "Offline-lading !{{er|er ikke}} slått på"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=charger"
          }
        ]
      },
      {
        "id": "defa_condition_error",
        "title": {
          "en": "The charger !{{has|hasn't}} an error",
          "no": "Laderen !{{har|har ikke}} en feil"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=charger"
          }
        ]
      }
    ],
    "actions": [
      {
        "id": "defa_action_start",
        "title": {
          "en": "Start charging",
          "no": "Start lading"
        },
        "deprecated": true,
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=charger"
          }
        ]
      },
      {
        "id": "defa_action_stop",
        "title": {
          "en": "Stop charging",
          "no": "Stopp lading"
        },
        "deprecated": true,
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=charger"
          }
        ]
      },
      {
        "id": "defa_action_set_eco_mode",
        "title": {
          "en": "Turn eco mode on or off",
          "no": "Slå eco-modus på eller av"
        },
        "titleFormatted": {
          "en": "Turn eco mode [[mode]]",
          "no": "Slå eco-modus [[mode]]"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=charger"
          },
          {
            "name": "mode",
            "type": "dropdown",
            "values": [
              {
                "id": "on",
                "label": {
                  "en": "on",
                  "no": "på"
                }
              },
              {
                "id": "off",
                "label": {
                  "en": "off",
                  "no": "av"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "defa_action_override_schedule",
        "title": {
          "en": "Charge now, ignoring smart charging",
          "no": "Lad nå, overstyr smartlading"
        },
        "hint": {
          "en": "Overrides the smart charging schedule so the car charges now instead of waiting for the planned hours. The schedule itself is kept and takes effect again for the next session.",
          "no": "Overstyrer smartladingsplanen slik at bilen lader nå i stedet for å vente på de planlagte timene. Selve planen beholdes og gjelder igjen for neste ladeøkt."
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=charger"
          }
        ]
      },
      {
        "id": "defa_action_reset",
        "title": {
          "en": "Restart the charger",
          "no": "Start laderen på nytt"
        },
        "titleFormatted": {
          "en": "Restart the charger with a [[type]] reset",
          "no": "Start laderen på nytt med [[type]] omstart"
        },
        "hint": {
          "en": "A soft reset restarts the charger's software and ends an ongoing charging session cleanly first. A hard reset reboots the charger as if the power had been cut, without ending the session cleanly. Use soft unless the charger has stopped responding.",
          "no": "Myk omstart starter laderens programvare på nytt og avslutter en pågående ladeøkt ryddig først. Hard omstart starter laderen på nytt som ved strømbrudd, uten å avslutte økten ryddig. Bruk myk med mindre laderen har sluttet å svare."
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=charger"
          },
          {
            "name": "type",
            "type": "dropdown",
            "values": [
              {
                "id": "soft",
                "label": {
                  "en": "soft",
                  "no": "myk"
                }
              },
              {
                "id": "hard",
                "label": {
                  "en": "hard",
                  "no": "hard"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "defa_action_refresh",
        "title": {
          "en": "Refresh the charger data",
          "no": "Oppdater laderdata"
        },
        "hint": {
          "en": "The data refreshes on its own. Use this to fetch the status right away, for example at the start of a Flow that acts on it.",
          "no": "Dataene oppdateres av seg selv. Bruk denne for å hente status med én gang, for eksempel i starten av en Flow som handler på den."
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=charger"
          }
        ]
      },
      {
        "id": "defa_action_set_current",
        "title": {
          "en": "Set the charging current",
          "no": "Sett ladestrømmen"
        },
        "titleFormatted": {
          "en": "Set the charging current to [[amps]] A",
          "no": "Sett ladestrømmen til [[amps]] A"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=charger"
          },
          {
            "name": "amps",
            "type": "number",
            "min": 7,
            "max": 32,
            "step": 1,
            "placeholder": {
              "en": "Amps",
              "no": "Ampere"
            }
          }
        ]
      },
      {
        "id": "defa_action_set_plug_and_charge",
        "title": {
          "en": "Turn Plug & Charge on or off",
          "no": "Slå Plug & Charge på eller av"
        },
        "titleFormatted": {
          "en": "Turn Plug & Charge [[mode]]",
          "no": "Slå Plug & Charge [[mode]]"
        },
        "hint": {
          "en": "On: charging starts as soon as a cable is connected, with no RFID tag or app needed. Anyone who plugs in charges on your electricity. Off: charging must be authorised first.",
          "no": "På: lading starter så snart kabelen kobles til, uten RFID-brikke eller app. Hvem som helst som plugger seg inn, lader på strømmen din. Av: lading må autoriseres først."
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=charger"
          },
          {
            "name": "mode",
            "type": "dropdown",
            "values": [
              {
                "id": "on",
                "label": {
                  "en": "on",
                  "no": "på"
                }
              },
              {
                "id": "off",
                "label": {
                  "en": "off",
                  "no": "av"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "defa_action_set_charge_offline",
        "title": {
          "en": "Turn offline charging on or off",
          "no": "Slå offline-lading på eller av"
        },
        "titleFormatted": {
          "en": "Turn offline charging [[mode]]",
          "no": "Slå offline-lading [[mode]]"
        },
        "hint": {
          "en": "If the charger loses its internet connection it turns on Plug & Charge by itself, so charging still works while it is offline. Anyone who plugs in can then charge without authorisation until the connection is back.",
